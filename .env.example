# --- Telegram ---
BOT_TOKEN=123456:replace-me
# Telegram ID шефов через запятую (у каждого шефа свои прорабы)
ADMIN_IDS=123456789

# --- PostgreSQL ---
DATABASE_URL=postgresql://foreman:foreman@localhost:5432/foreman

# --- Часовой пояс и утренняя сводка ---
TZ=Asia/Dushanbe
DIGEST_HOUR=8

# --- Дашборд (Telegram Mini App) ---
# Публичный HTTPS-адрес, по которому снаружи доступен WEB_PORT. Пусто — дашборд выключен.
WEBAPP_URL=
# Если перед ботом стоит nginx/Caddy на этом же сервере, оставьте 127.0.0.1
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Кэш фото и голосовых для дашборда (скачиваются из Telegram один раз)
MEDIA_CACHE_DIR=data/media
MEDIA_CACHE_MB=500
